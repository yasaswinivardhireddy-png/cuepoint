*.prof

# Terraform state and plugins (state from local or CI runs against the emulator)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Secrets generated for local clusters
secrets.env
.env

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
