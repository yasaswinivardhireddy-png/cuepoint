{
  "name": "cuepoint-api",
  "version": "1.0.0",
  "description": "Campaign API for the Cuepoint ad platform: campaigns, creatives, targeting, delivery reporting and the ad server's campaign snapshot.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "openapi": "node --disable-warning=ExperimentalWarning scripts/openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "@fastify/jwt": "10.2.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "fastify": "5.12.7",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@smithy/core": "3.36.2"
  }
}
