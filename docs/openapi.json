                          },
                          "mediaUrl": {
                            "type": "string"
                          },
                          "mimeType": {
                            "type": "string"
                          },
                          "width": {
                            "type": "integer"
                          },
                          "height": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "version": {
                      "type": "integer"
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "string"
                    },
                    "deliveredToday": {
                      "type": "integer",
                      "description": "Impressions counted so far today"
                    }
                  }
                }
              }
            }
