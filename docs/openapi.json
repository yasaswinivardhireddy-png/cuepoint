      "post": {
        "tags": [
          "campaigns"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "category",
                  "startDate",
                  "endDate",
                  "dailyImpressionGoal",
                  "cpmCents",
                  "creatives"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 80
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "paused"
                    ],
                    "default": "active"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date",
                    "description": "UTC calendar day, YYYY-MM-DD"
                  },
                  "dailyImpressionGoal": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 10000000
                  },
                  "cpmCents": {
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 100000,
                    "description": "Price per thousand impressions, in cents"
                  },
                  "frequencyCapPerDay": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50,
                    "description": "Impressions per viewer per day; 0 means no cap",
                    "default": 0
                  },
                  "targeting": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "genres": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "enum": [
                            "sports",
                            "news",
                            "drama",
                            "comedy",
                            "kids",
                            "reality",
                            "documentary"
                          ]
                        }
                      },
                      "devices": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "enum": [
                            "ctv",
                            "mobile",
                            "web"
                          ]
                        }
                      },
                      "countries": {
                        "type": "array",
                        "uniqueItems": true,
                        "maxItems": 50,
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Z]{2}$"
                        }
                      }
                    },
                    "description": "Empty or missing lists target everyone"
                  },
                  "advertiserId": {
                    "type": "string",
                    "pattern": "^adv-[a-z0-9-]{2,40}$",
                    "description": "Admins only; advertisers always create for themselves"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "beverage",
                      "finance",
                      "insurance",
                      "telecom",
                      "travel",
                      "retail",
                      "food",
                      "tech",
                      "entertainment"
                    ]
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date",
                    "description": "UTC calendar day, YYYY-MM-DD"
                  },
                  "creatives": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 5,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "durationSec",
                        "mediaUrl"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "durationSec": {
                          "type": "integer",
                          "enum": [
                            6,
                            10,
                            15,
                            20,
                            30,
                            60
                          ]
                        },
                        "mediaUrl": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^https://",
                          "maxLength": 500
                        },
                        "width": {
                          "type": "integer",
                          "minimum": 320,
                          "maximum": 7680,
                          "default": 1920
                        },
                        "height": {
                          "type": "integer",
                          "minimum": 180,
                          "maximum": 4320,
                          "default": 1080
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
